#version 460 core

#include "processInstances.glsl"

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

struct InstanceData {
    mat4 old;
    mat4 new;
    mat4 current;
};

DECLARE_PROCESS_INSTANCES_BUFFERS(InstanceData);

uniform float interp;

void main() {
    const mat4 current = (instancesData[gl_GlobalInvocationID.x].old * (1 - interp))
	+ (instancesData[gl_GlobalInvocationID.x].new * interp);

    //instance is visible
    instancesData[gl_GlobalInvocationID.x].current = pvMat * current;

    const uint meshId = instancesMeshIds[gl_GlobalInvocationID.x];
    const uint localMeshInstanceId = atomicAdd(commands[meshId].instanceCount, 1);

    usedInstancesIds[commands[meshId].baseInstance + localMeshInstanceId] = gl_GlobalInvocationID.x;
}
