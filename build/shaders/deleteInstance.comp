#version 460 core

#include "commands.glsl"

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

DECLARE_COMMANDS();

layout (binding = 5, std430) writeonly buffer instancesMeshIdsBuffer {
    uint instancesMeshIds[];
};

uniform uint baseMeshId;

void main() {
    const uint meshId = baseMeshId + gl_GlobalInvocationID.x;

    --commands[meshId].baseInstance;

    //make sure that we expand the non zero region
    if (commands[meshId].count != 0) {
	instancesMeshIds[commands[meshId].baseInstance] = meshId;
    }
}
